{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Recall",
  "version": "0.1.12",
  "identifier": "com.recallapp.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:51820",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recall",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/screenshots/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERjY5MzQxQ0MzRTlGNkMKUldSc256N01RWlAyemQva3lTSUlBK2VPVEhDeGoyNjN1dTloeG1mSDc0TlVGSDFPRjVyWEtOaEQK",
      "endpoints": [
        "https://github.com/zion-deer/Recall/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "A private memory for your computer",
    "longDescription": "Recall remembers what you do on your computer so you can find it later. Everything stays on your device.",
    "copyright": "Copyright © 2026 Recall. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
