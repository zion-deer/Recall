{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Recall's main window. Only the bundled UI can call these.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "dialog:allow-save",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-get-recorder-status",
    "allow-get-browser-statuses",
    "allow-list-events",
    "allow-search-events",
    "allow-get-event",
    "allow-get-app-usage",
    "allow-get-memory-stats",
    "allow-delete-event",
    "allow-delete-events-in-range",
    "allow-delete-screenshots",
    "allow-delete-all-memories",
    "allow-list-exclusions",
    "allow-add-exclusion",
    "allow-remove-exclusion",
    "allow-export-data",
    "allow-get-permissions",
    "allow-request-permission",
    "allow-open-data-folder",
    "allow-open-log-folder",
    "allow-open-url",
    "allow-open-path",
    "allow-get-ai-status",
    "allow-download-ai-model",
    "allow-cancel-ai-download",
    "allow-remove-ai-model",
    "allow-ask-recall",
    "allow-get-app-icon",
    "allow-check-for-update",
    "allow-install-update",
    "allow-relaunch"
  ]
}
